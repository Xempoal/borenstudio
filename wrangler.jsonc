{
  // Proyecto de Cloudflare Pages de borenstudio.com.
  // Sitio estatico: la raiz del repo ES la salida del build (no hay bundler).
  //
  // Aqui NO van credenciales. Las llaves S3 de R2 viven como secrets del
  // proyecto (`wrangler pages secret put`). Ver README-carga.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "borenstudio",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".",

  // Binding usado SOLO por el panel de administrador (listar y armar el zip).
  // Las subidas de los clientes nunca pasan por aqui: van directo a R2 con URL prefirmada.
  "r2_buckets": [
    {
      "binding": "CARGAS",
      "bucket_name": "cargas-clientes"
    }
  ],

  // Estado chico que no cabe en las claves de R2: el contador de la cuota
  // mensual y los bloqueos por PIN fallido. No es una base de datos del
  // proyecto; los archivos y sus carpetas siguen viviendo solo en R2.
  "kv_namespaces": [
    {
      "binding": "ESTADO",
      "id": "eed7373c61644e9fad39c56355cfd191"
    }
  ],

  // El panel ya no usa Cloudflare Access: entra con un PIN. El PIN y la llave
  // que firma la sesion son secrets (PANEL_PIN, PANEL_SESSION_SECRET), nunca
  // van aqui. Sin ellos el panel responde 503: falla cerrado.
}
