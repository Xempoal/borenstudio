{
  "rules": [
    {
      "id": "subida-directa-desde-borenstudio",
      "allowed": {
        "origins": [
          "https://borenstudio.com",
          "https://www.borenstudio.com",
          "https://borenstudio.pages.dev"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
