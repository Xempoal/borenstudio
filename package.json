{
  "name": "borenstudio",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de Boren Studio (Cloudflare Pages) + portal de carga de archivos para clientes.",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "css": "tailwindcss -i src/estilos.css -o carga/assets/estilos.css --minify",
    "css:watch": "tailwindcss -i src/estilos.css -o carga/assets/estilos.css --watch",
    "motion": "esbuild node_modules/motion/dist/es/mini.mjs --bundle --format=esm --minify --target=es2022 --outfile=carga/assets/motion.js",
    "test:zip": "node scripts/test-zip.mjs",
    "vendor:aws4fetch": "node scripts/vendor-aws4fetch.mjs",
    "build:landing": "esbuild src/studio.js --bundle --minify --format=iife --target=es2022 --outfile=assets/studio.bundle.js",
    "test:landing": "playwright test",
    "build": "npm run css && npm run motion && npm run vendor:aws4fetch && npm run build:landing"
  },
  "//": "Cloudflare NO corre build en este proyecto: todo esto se ejecuta a mano y el resultado ya compilado (carga/assets/*, functions/_lib/aws4fetch.js) se sube al repo. Ver README-carga.md.",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "aws4fetch": "^1.0.20",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lucide": "^1.43.0",
    "motion": "^13.1.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "wrangler": "^4.123.0"
  }
}
